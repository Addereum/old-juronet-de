# Aktiviert die Fehler-Umleitungen auf die eigenen Retro-Seiten
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# Sinnvolle Schutz- und Performance-Regeln für statische Retro-Seiten
<IfModule mod_headers.c>
    # Verhindert ungewolltes Einbetten in fremde Iframes (Clickjacking-Schutz)
    Header set X-Frame-Options "SAMEORIGIN"
    # XSS-Schutz
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Caching-Regeln für blitzschnelles Laden (damals wie heute wichtig)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
